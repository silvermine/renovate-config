{
   "$schema": "https://docs.renovatebot.com/renovate-schema.json",
   "extends": [
      "config:recommended"
   ],
   "lockFileMaintenance": { "enabled": true },
   "nvm": { "enabled": false },
   "semanticCommitScope": "",
   "packageRules": [
      {
         "matchPackageNames": [ "*" ],
         "minimumReleaseAge": "7 days"
      },
      {
         "groupName": "tauri (npm + cargo) coordinated update",
         "matchManagers": ["npm", "cargo"],
         "matchPackageNames": [
            "@tauri-apps/api",
            "@tauri-apps/cli",
            "tauri",
            "tauri-build",
            "/^@tauri-apps\\/plugin-/",
            "/^tauri-plugin-/"
         ]
      },
      {
         "matchPackageNames": [ "/^@silvermine\//" ],
         "minimumReleaseAge": null
      }
   ],
   "ignoreDeps": [ "@types/node" ]
}
